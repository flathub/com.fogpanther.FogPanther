{
    "app-id": "com.fogpanther.FogPanther",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "fogpanther",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=cups",
        "--device=dri",
        "--filesystem=xdg-pictures:rw",
        "--filesystem=xdg-documents:rw",
        "--filesystem=xdg-download:rw",
        "--filesystem=xdg-desktop:rw",
        "--filesystem=/run/media",
        "--filesystem=/media",
        "--env=GDK_PIXBUF_MODULE_FILE=/app/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"
    ],
    "modules": [
        {
            "name": "fogpanther",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 bin/fogpanther bin/fogpanther-thumbnailer -t /app/bin/",
                "cp -a lib/. /app/lib/",
                "cp -a share/. /app/share/",
                "gdk-pixbuf-query-loaders /app/lib/gdk-pixbuf-2.0/2.10.0/loaders/*.so /usr/lib/*/gdk-pixbuf-2.0/2.10.0/loaders/*.so > /app/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache",
                "sed -i 's|;photoshop;gimp;|;|' /app/share/applications/com.fogpanther.FogPanther.desktop"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.fogpanther.com/releases/fogpanther-0.8.1-1-x86_64.tar.xz",
                    "sha256": "0770951a1a25f5b39c76f5b21ffc2bfe98ca8939e630a9c166ea0a22ffeade1e",
                    "only-arches": ["x86_64"]
                },
                {
                    "type": "archive",
                    "url": "https://www.fogpanther.com/releases/fogpanther-0.8.1-1-aarch64.tar.xz",
                    "sha256": "0f9c47229f1611944c78d9f0091c8d43e9e4b059015bbaeb578200c3bdae8218",
                    "only-arches": ["aarch64"]
                }
            ]
        }
    ]
}
